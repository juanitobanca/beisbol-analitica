{
    "gamePk": {
        "type": "INTEGER",
        "path": "data['gamePk']"
    },
    "inning": {
        "type": "INTEGER",
        "path": "data['liveData']['plays']['allPlays'][id]['about']['inning']"
    },
    "halfInning": {
        "type": "TEXT",
        "path": "data['liveData']['plays']['allPlays'][id]['about']['halfInning']"
    },
    "atBatIndex": {
        "type": "INTEGER",
        "path": "data['liveData']['plays']['allPlays'][id]['about']['atBatIndex']"
    },
    "battingTeamId": {
        "type": "INTEGER",
        "path": "data['gameData']['teams']['away']['id'] if data['liveData']['plays']['allPlays'][id]['about']['halfInning'] == 'top' else data['gameData']['teams']['home']['id']"
    },
    "pitchingTeamId": {
        "type": "INTEGER",
        "path": "data['gameData']['teams']['home']['id'] if data['liveData']['plays']['allPlays'][id]['about']['halfInning'] == 'top' else data['gameData']['teams']['away']['id']"
    },
    "endOuts": {
        "type": "INTEGER",
        "path": "data['liveData']['plays']['allPlays'][id]['count']['outs']"
    },
    "endBalls": {
        "type": "INTEGER",
        "path": "data['liveData']['plays']['allPlays'][id]['count']['balls']"
    },
    "endStrikes": {
        "type": "INTEGER",
        "path": "data['liveData']['plays']['allPlays'][id]['count']['strikes']"
    },
    "batterId": {
        "type": "INTEGER",
        "path": "int(data['liveData']['plays']['allPlays'][id]['matchup']['batter']['id'])"
    },
    "pitcherId": {
        "type": "INTEGER",
        "path": "int(data['liveData']['plays']['allPlays'][id]['matchup']['pitcher']['id'])"
    },
    "hasOut": {
        "type": "INTEGER",
        "path": "int(data['liveData']['plays']['allPlays'][id]['about']['hasOut'])"
    },
    "hasReview": {
        "type": "INTEGER",
        "path": "int(data['liveData']['plays']['allPlays'][id]['about']['hasReview'])"
    },
    "isScoringPlay": {
        "type": "INTEGER",
        "path": "data['liveData']['plays']['allPlays'][id]['about']['isScoringPlay']"
    },
    "rbi": {
        "type": "INTEGER",
        "path": "data['liveData']['plays']['allPlays'][id]['result']['rbi']"
    },
    "awayScore": {
        "type": "INTEGER",
        "path": "data['liveData']['plays']['allPlays'][id]['result']['awayScore']"
    },
    "homeScore": {
        "type": "INTEGER",
        "path": "data['liveData']['plays']['allPlays'][id]['result']['homeScore']"
    },
    "event": {
        "type": "TEXT",
        "path": "data['liveData']['plays']['allPlays'][id]['result']['event']"
    },
    "eventType": {
        "type": "TEXT",
        "path": "data['liveData']['plays']['allPlays'][id]['result']['eventType']"
    },
    "batSide": {
        "type": "TEXT",
        "path": "data['liveData']['plays']['allPlays'][id]['matchup']['batSide']['description']"
