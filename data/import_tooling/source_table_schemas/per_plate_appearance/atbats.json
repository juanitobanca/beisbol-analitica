    "pitchHand": {
        "type": "TEXT",
        "path": "data['liveData']['plays']['allPlays'][id]['matchup']['pitchHand']['description']"
    },
    "menOnBase": {
        "type": "TEXT",
        "path": "len(data['liveData']['plays']['allPlays'][id]['runners'])-1"
    },
    "description": {
        "type": "TEXT",
        "path": "data['liveData']['plays']['allPlays'][id]['result']['description']"
    },
    "pitches": {
        "type": "INTEGER",
        "path": "len(data['liveData']['plays']['allPlays'][id]['pitchIndex'])"
    }
}