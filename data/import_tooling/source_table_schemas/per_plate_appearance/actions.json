{
    "gamePk": {
        "type": "INTEGER",
        "path": "data['gamePk']"
    },
    "inning": {
        "type": "INTEGER",
        "path": "data['liveData']['plays']['allPlays'][id]['about']['inning']"
    },
    "halfInning": {
        "type": "TEXT",
        "path": "data['liveData']['plays']['allPlays'][id]['about']['halfInning']"
    },
    "pitchingTeamId": {
        "type": "INTEGER",
        "path": "data['gameData']['teams']['home']['id'] if data['liveData']['plays']['allPlays'][id]['about']['halfInning'] == 'top' else data['gameData']['teams']['away']['id']"
    },
    "battingTeamId": {
        "type": "INTEGER",
        "path": "data['gameData']['teams']['away']['id'] if data['liveData']['plays']['allPlays'][id]['about']['halfInning'] == 'top' else data['gameData']['teams']['home']['id']"
    },
    "atBatIndex": {
        "type": "INTEGER",
        "path": "data['liveData']['plays']['allPlays'][id]['about']['atBatIndex']"
    },
    "playIndex": {
        "type": "INTEGER",
        "path": "data['liveData']['plays']['allPlays'][id]['runners'][0]['details']['playIndex']"
    },
    "playerId": {
        "type": "REAL",
        "path": "data['liveData']['plays']['allPlays'][id]['matchup']['batter']['id']"
    },
    "endOuts": {
        "type": "INTEGER",
        "path": "data['liveData']['plays']['allPlays'][id]['count']['outs']"
    },
    "endBalls": {
        "type": "INTEGER",
        "path": "data['liveData']['plays']['allPlays'][id]['count']['balls']"
    },
    "endStrikes": {
        "type": "INTEGER",
        "path": "data['liveData']['plays']['allPlays'][id]['count']['strikes']"
    },
    "hasReview": {
        "type": "INTEGER",
        "path": "int(data['liveData']['plays']['allPlays'][id]['about']['hasReview'])"
    },
    "isScoringPlay": {
        "type": "INTEGER",
        "path": "data['liveData']['plays']['allPlays'][id]['about']['isScoringPlay']"
    },
    "awayScore": {
        "type": "INTEGER",
        "path": "data['liveData']['plays']['allPlays'][id]['result']['awayScore']"
    },
    "homeScore": {
        "type": "INTEGER",
        "path": "data['liveData']['plays']['allPlays'][id]['result']['homeScore']"
    },
    "event": {
        "type": "TEXT",
        "path": "data['liveData']['plays']['allPlays'][id]['result']['event']"
    },
    "eventType": {
        "type": "TEXT",
        "path": "data['liveData']['plays']['allPlays'][id]['result']['eventType']"
    },
    "battingOrder": {
        "type": "REAL",
        "path": "data['liveData']['boxscore']['teams']['away' if data['liveData']['plays']['allPlays'][id]['about']['halfInning'] == 'top' else 'home']['batters'].index(data['liveData']['plays']['allPlays'][id]['matchup']['batter']['id'])"
    },
    "positionAbbrev": {
        "type": "TEXT",
        "path": "data['gameData']['players']['ID'+str(data['liveData']['plays']['allPlays'][id]['matchup']['batter']['id'])]['primaryPosition']['name']"
    },
    "description": {
        "type": "TEXT",
        "path": "data['liveData']['plays']['allPlays'][id]['result']['description']"
    }
}
